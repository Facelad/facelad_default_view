---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Facelad Hosting">
  <main>
    <section class="hero">
      <a href="https://facelad.com" target="_blank" rel="noopener noreferrer">
        <img class="hero-logo" src="/image/facelad.png" alt="facelad logo" />
      </a>
      <div class="hero-copy">
        <h1>¡Tu Hosting y/o Dominio está listo!</h1>
        <p>
          Esta página se creó automáticamente para verificar la correcta creación
          y funcionamiento ❤ de tu nueva cuenta de hosting y/o dominio.
        </p>
      </div>
    </section>
  </main>

  <footer>
    <p>® 2023 Todos los Derechos Reservados</p>
    <p>
      Made with <span class="heart">❤</span> by
      <a href="https://facelad.com" target="_blank" rel="noopener noreferrer">facelad</a>
    </p>
  </footer>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
  }

  .hero {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    min-height: 90vh;
    padding: 2rem 1rem;
  }

  .hero-logo {
    height: 7rem;
    margin-bottom: 3rem;
  }

  .hero-copy {
    max-width: 550px;
    text-align: center;
    padding: 0 1rem;
  }

  .hero-copy h1 {
    margin-bottom: 1rem;
    font-size: clamp(1.2rem, 5vw, 1.8rem);
  }

  .hero-copy p {
    font-size: clamp(0.95rem, 2.5vw, 1.25rem);
    line-height: 1.8rem;
  }

  footer {
    min-height: 10vh;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 3rem;
    padding: 1rem;
  }

  footer p {
    font-size: 16px;
    line-height: 1.8rem;
    margin: 0;
  }

  footer a {
    text-decoration: none;
    color: #11103f;
    font-weight: bold;
  }

  .heart {
    color: red;
  }

  @media (max-width: 480px) {
    .hero-logo {
      height: 5rem;
      margin-bottom: 2rem;
    }

    footer {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
